# Which AI interprets feedback: anthropic (default) | openai | gemini | ollama
LLM_PROVIDER=anthropic

# --- anthropic (Claude). Model defaults to claude-opus-5-5.
ANTHROPIC_API_KEY=

# --- openai: also works with any OpenAI-compatible API (OpenRouter, Groq, Together, LM Studio…)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# UNSHOP_MODEL=        # required: a model name from your provider's model list

# --- gemini
# GEMINI_API_KEY=
# UNSHOP_MODEL=        # required: a Gemini model name

# --- ollama: local models, no key, nothing leaves your machine. Run `ollama pull <model>` first.
# OLLAMA_HOST=http://localhost:11434
# UNSHOP_MODEL=qwen2.5:7b

# Optional for any provider: override the model or port.
# UNSHOP_MODEL=
# PORT=8787
