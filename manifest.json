{
  "manifest_version": 3,
  "name": "UnShop — find it by ruling things out",
  "version": "0.4.0",
  "description": "An unofficial shopping overlay for Amazon, eBay, Walmart, Target and Best Buy search pages that learns what you want from what you reject.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/s*",
        "https://*.amazon.com/*/s*",
        "https://www.ebay.com/sch/*",
        "https://www.walmart.com/*",
        "https://www.target.com/*",
        "https://www.bestbuy.com/site/*"
      ],
      "js": [
        "src/model.runtime.js",
        "src/sites.js",
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "UnShop",
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html"
}
